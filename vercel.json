{
  "rewrites": [
    {
      "source": "/auth/v1/:path*",
      "destination": "https://ezjjehppuefzzromlbrk.supabase.co/auth/v1/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/nexus-build.txt",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    }
  ],
  "alias": [
    "nexus-academy-one.vercel.app",
    "mandarb77-nexus-academy.vercel.app"
  ]
}
